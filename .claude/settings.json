{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/desk_guard.py\" || { rc=$?; [ \"$DESK_ROUTINE\" = 1 ] && exit 2; exit $rc; }"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/desk_guard.py\" || { rc=$?; [ \"$DESK_ROUTINE\" = 1 ] && exit 2; exit $rc; }"
          }
        ]
      },
      {
        "matcher": "mcp__.*|Cron.*|Remote.*|Schedule.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/desk_guard.py\" || { rc=$?; [ \"$DESK_ROUTINE\" = 1 ] && exit 2; exit $rc; }"
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/desk_guard.py\" || { rc=$?; [ \"$DESK_ROUTINE\" = 1 ] && exit 2; exit $rc; }"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/desk_guard.py\" || { rc=$?; [ \"$DESK_ROUTINE\" = 1 ] && exit 2; exit $rc; }"
          }
        ]
      }
    ]
  }
}
